# The API runs on FullBackendd (separate repo); its CROPGUARD_* settings live in that repo's
# .env (see its .env.example). This file only holds the client-side settings.
# --- Web (Vite): FullBackendd origin, baked in at build time (web/.env) ---
VITE_API_URL=http://localhost:7004
# --- Mobile (Expo): FullBackendd origin as the phone can reach it ---
EXPO_PUBLIC_API_URL=http://192.168.1.20:7004
